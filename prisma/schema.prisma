generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  email                 String                 @unique
  address               String?
  phone                 String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  employmentHistories   EmploymentHistory[]
  departments           Department[]
  disciplinaryRecords   DisciplinaryRecord[]
  employees             Employee[]
  users                 User[]
  onboardingInvitations OnboardingInvitation[]
  employeeDocuments     EmployeeDocument[]

  onboardingSubmissions OnboardingSubmission[]

  onboardingTemplates  OnboardingTemplate[]
  offerLetterTemplates OfferLetterTemplate[]
  employeeOfferLetters OfferLetterDocument[]

  employeeOnboardingTask        EmployeeOnboardingTask[]
  companyOnboardingTaskTemplate OnboardingTaskTemplate[]
  companyJobRequisitions        JobRequisition[]
  companyJobOpenings            JobOpening[]
  jobOpeningCandidates          Candidate[]
  companyRecruitmentStage       RecruitmentStage[]
  companyJobApplications        JobApplication[]
  companyJobOffers              JobOffer[]
  companyRecruitmentActivity    RecruitmentActivity[]

  companyLeaveTypes LeaveType[]
  leaveRequests     LeaveRequest[]
  publicHolidays    PublicHoliday[]
  leavePolicy       LeavePolicy?
  salaryComponents  PayrollComponent[]

  payrollRuns PayrollRun[]

  salaryAdvance SalaryAdvance[]
  payrollRules  PayrollRule[]

  @@map("companies")
}

model Employee {
  id                   String                   @id @default(uuid()) @db.Uuid
  companyId            String                   @db.Uuid
  employeeCode         String
  firstName            String
  lastName             String
  gender               Gender
  dateOfBirth          DateTime?
  address              String?
  jobTitle             String?
  employmentType       EmploymentType?
  compensation         Int?
  managerId            String?                  @db.Uuid
  employmentStatus     EmploymentStatus         @default(ACTIVE)
  departmentId         String?                  @db.Uuid
  userId               String                   @unique @db.Uuid
  hireDate             DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  createdAt            DateTime                 @default(now())
  deletedAt            DateTime?
  // some companies would put new employees on probation
  isProbation          Boolean?                 @default(false)
  probationPeriod      DateTime?
  employmentHistory    EmploymentHistory[]
  headedDepartments    Department[]             @relation("DepartmentHead")
  disciplinaryRecords  DisciplinaryRecord[]
  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department           Department?              @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  manager              Employee?                @relation("ManagerEmployees", fields: [managerId], references: [id])
  subordinates         Employee[]               @relation("ManagerEmployees")
  user                 User                     @relation(fields: [userId], references: [id])
  employeeDocument     EmployeeDocument[]
  onboardingSubmission OnboardingSubmission?
  onboardingTasks      EmployeeOnboardingTask[]

  leaveBalances          EmployeeLeaveBalance[]
  uploadedLeaveDocuments LeaveRequestDocument[]
  leaveRequests          LeaveRequest[]         @relation("currentLeaveRequests")
  relievedRequests       LeaveRequest?          @relation("assignedReliever")
  employeeCompensations  EmployeeCompensation[]

  payrollItems  PayrollItem[]
  salaryAdvance SalaryAdvance[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([departmentId])
  @@map("employees")
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  name                 String
  email                String                 @unique
  password             String
  phone                String?
  role                 Role
  isActive             Boolean                @default(true)
  lastLogin            DateTime?
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  companyId            String                 @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  disciplinaryCreated  DisciplinaryRecord[]   @relation("DisciplinaryCreatedBy")
  disciplinaryResolved DisciplinaryRecord[]   @relation("DisciplinaryResolvedBy")
  eobManager           OnboardingInvitation[] @relation("EOBManager")
  employee             Employee?
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedDocuments    EmployeeDocument[]

  createdOnboardingTemplates OnboardingTemplate[] @relation("CreatedOnboardingTemplates")

  createdInvitations  OnboardingInvitation[] @relation("InvitationCreatedBy")
  reviewedSubmissions OnboardingSubmission[] @relation("SubmissionReviewedBy")

  reviewedDocuments OnboardingDocument[] @relation("DocumentReviewedBy")

  uploadedOfferLetterTemplates OfferLetterTemplate[]
  onboardingTasksAssignedTo    EmployeeOnboardingTask[] @relation("AssignedOnboardingTask")
  onboardingTasksCompleted     EmployeeOnboardingTask[] @relation("CompletedOnboardingTask")
  templatesCreated             OnboardingTaskTemplate[] @relation("TaskTemplateCreatedBy")
  assignedUserOnTemplate       OnboardingTaskTemplate[] @relation("TemplateAssignedUser")

  createdRequisitions            JobRequisition[] @relation("RequestedRequisitions")
  approvedOrRejectedRequisitions JobRequisition[] @relation("ApprovedOrRejectedRequisitions")

  applicationStageMoves    ApplicationStageHistory[]
  rejectedApplicatins      JobApplication[]
  candidateNotesCreated    CandidateNote[]
  recruitmentActivityActor RecruitmentActivity[]

  hiringTeam           JobOpeningHiringTeam[]
  approvedLeaveRequest LeaveRequest[]         @relation("acceptance")
  rejectedLeaveRequest LeaveRequest[]         @relation("rejection")
  leaveApprovalHistory LeaveApprovalHistory[]

  generatedPayrollRuns     PayrollRun[]
  salary_advance_approvals SalaryAdvance[] @relation("salary_advance_approvals")
  salary_advance_reqs      SalaryAdvance[] @relation("salary_advance_reqs")

  uploadedAdvanceReceipts AdvanceReceipt[]

  @@index([companyId])
  @@map("users")
}

model Department {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @db.Uuid
  name                  String
  description           String?
  status                DepartmentStatus       @default(ACTIVE)
  parentDepartmentId    String?                @db.Uuid
  headEmployeeId        String?                @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  employmentHistory     EmploymentHistory[]
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  headEmployee          Employee?              @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  parentDepartment      Department?            @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments        Department[]           @relation("DepartmentHierarchy")
  employees             Employee[]             @relation("DepartmentEmployees")
  onboardingSubmissions OnboardingSubmission[]
  onboardingInvitations OnboardingInvitation[]

  departmentRequisitions JobRequisition[]
  departmentOpenings     JobOpening[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([headEmployeeId])
  @@index([parentDepartmentId])
  @@map("departments")
}

model EmploymentHistory {
  employeeId   String      @db.Uuid
  departmentId String?     @db.Uuid
  jobTitle     String
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  companyId    String      @db.Uuid
  id           String      @id @default(uuid()) @db.Uuid
  company      Company     @relation(fields: [companyId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  employee     Employee    @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([employeeId, isCurrent])
  @@index([isCurrent])
  @@map("employment_history")
}

model DisciplinaryRecord {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @db.Uuid
  employeeId      String               @db.Uuid
  type            DisciplinaryType
  severity        DisciplinarySeverity
  title           String
  description     String
  status          DisciplinaryStatus   @default(OPEN)
  createdById     String               @db.Uuid
  resolvedById    String?              @db.Uuid
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("DisciplinaryCreatedBy", fields: [createdById], references: [id])
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resolvedBy      User?                @relation("DisciplinaryResolvedBy", fields: [resolvedById], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("disciplinary_records")
}

// This is the part for pre onboarding and post onboarding

model OnboardingInvitation {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  templateId String?             @db.Uuid
  template   OnboardingTemplate? @relation(fields: [templateId], references: [id])

  invitedById String @db.Uuid
  invitedBy   User   @relation("InvitationCreatedBy", fields: [invitedById], references: [id])

  email String

  token String @unique

  expiresAt    DateTime
  jobTitle     String
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  invitationStatus  InvitationStatus @default(PENDING)
  requiredDocuments Json
  onboardingStatus  OnboardingStatus @default(INVITED)

  compensation   String
  managerId      String?        @db.Uuid
  manager        User?          @relation("EOBManager", fields: [managerId], references: [id])
  employmentType EmploymentType

  acceptedAt          DateTime?
  declinedAt          DateTime?
  offerLetterDocument OfferLetterDocument?
  submission          OnboardingSubmission?

  // Note this is important

  // jobApplicationId String?     @db.Uuid
  // jobApplication   JobApplication? @relation(fields: [jobApplicationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@map("onboarding_invitations")
}

model OnboardingSubmission {
  id String @id @default(uuid()) @db.Uuid

  invitationId String               @unique @db.Uuid
  invitation   OnboardingInvitation @relation(fields: [invitationId], references: [id])

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  firstName String
  lastName  String

  phoneNumber String?

  address String?

  dateOfBirth DateTime?

  emergencyContactName  String?
  emergencyContactPhone String?
  gender                Gender

  jobTitle String?

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  status OnboardingStatus @default(IN_PROGRESS)

  submittedAt DateTime?

  reviewedById String? @db.Uuid
  reviewedBy   User?   @relation("SubmissionReviewedBy", fields: [reviewedById], references: [id])

  reviewedAt DateTime?

  rejectionReason String?

  documents  OnboardingDocument[]
  employeeId String?              @unique @db.Uuid
  employee   Employee?            @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("onboarding_submissions")
}

model OnboardingDocument {
  id String @id @default(uuid()) @db.Uuid

  submissionId String               @db.Uuid
  submission   OnboardingSubmission @relation(fields: [submissionId], references: [id])

  documentType String

  originalFileName String

  storageKey String

  mimeType String

  fileSize Int

  reviewStatus DocumentReviewStatus @default(PENDING)

  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("DocumentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([reviewStatus])
  @@map("onboarding_documents")
}

model OnboardingTemplate {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name String

  description String?

  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  documentRequirements TemplateDocumentRequirement[]

  createdById String @db.Uuid
  createdBy   User   @relation("CreatedOnboardingTemplates", fields: [createdById], references: [id])

  invitations OnboardingInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, name])
  @@map("onboarding_templates")
}

model TemplateDocumentRequirement {
  id String @id @default(uuid()) @db.Uuid

  templateId String             @db.Uuid
  template   OnboardingTemplate @relation(fields: [templateId], references: [id])

  documentType String

  isRequired Boolean @default(true)

  description String?

  createdAt DateTime @default(now())

  @@map("template_document_requirements")
}

model EmployeeDocument {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  documentType String

  originalFileName String

  storageKey String

  mimeType String

  fileSize Int

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([companyId])
  @@map("employee_documents")
}

model OfferLetterTemplate {
  id String @id @default(uuid()) @db.Uuid

  fileName   String
  storageKey String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
  @@map("offer_letter_templates")
}

model OfferLetterDocument {
  id String @id @default(uuid()) @db.Uuid

  fileName String

  storageKey String

  mimeType String

  fileSize Int

  uploadedById String

  createdAt DateTime @default(now())

  companyId    String                @db.Uuid
  company      Company               @relation(fields: [companyId], references: [id])
  invitationId String?               @db.Uuid
  invitation   OnboardingInvitation? @relation(fields: [invitationId], references: [id])

  // jobOfferId String? @unique
  // jobOpening JobOffer? @relation(fields: [jobOfferId], references: [id])

  @@unique(invitationId)
  @@index([companyId])
  @@map("offer_letter_documents")
}

model OnboardingTaskTemplate {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title String

  description String?

  responsibility TaskResponsibility

  /**
   * Used only when responsibility = SPECIFIC_USER
   */
  assignedUserId String? @db.Uuid
  assignedUser   User?   @relation("TemplateAssignedUser", fields: [assignedUserId], references: [id])

  isActive Boolean @default(true)

  createdById String @db.Uuid
  createdBy   User   @relation("TaskTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedTasks EmployeeOnboardingTask[]

  @@index([companyId])
  @@index([isActive])
  @@map("onboarding_task_templates")
}

model EmployeeOnboardingTask {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  templateId String?                 @db.Uuid
  template   OnboardingTaskTemplate? @relation(fields: [templateId], references: [id])

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  title String

  description String?

  assignedToUserId String @db.Uuid
  assignedToUser   User   @relation("AssignedOnboardingTask", fields: [assignedToUserId], references: [id])

  status OnboardingTaskStatus @default(PENDING)

  completedById String? @db.Uuid
  completedBy   User?   @relation("CompletedOnboardingTask", fields: [completedById], references: [id])

  completedAt DateTime?
  startedAt   DateTime?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([companyId])
  @@map("employee_onboarding_tasks")
}

// Where pre and post onboarding ends

// WHere recruitment begins 
model JobRequisition {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  requestedById String @db.Uuid
  requestedBy   User   @relation("RequestedRequisitions", fields: [requestedById], references: [id])

  approvedOrRejectedById String? @db.Uuid
  approvedOrRejectedBy   User?   @relation("ApprovedOrRejectedRequisitions", fields: [approvedOrRejectedById], references: [id])

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  jobTitle String

  numberOfPositions Int

  salaryRangeMin Decimal? @db.Decimal(18, 2)
  salaryRangeMax Decimal? @db.Decimal(18, 2)

  reason String

  priority String?

  status RequisitionStatus @default(PENDING)

  rejectionReason String?

  reviewedAt DateTime?

  jobOpening JobOpening?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobOpening {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  requisitionId String         @unique @db.Uuid
  requisition   JobRequisition @relation(fields: [requisitionId], references: [id])

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  title String

  description String? @db.Text

  location String?

  employmentType EmploymentType?

  salaryMin Decimal? @db.Decimal(18, 2)
  salaryMax Decimal? @db.Decimal(18, 2)

  status JobOpeningStatus @default(DRAFT)

  publishedAt DateTime?
  closedAt    DateTime?

  applications JobApplication[]
  offers       JobOffer[]

  jobOpeningSettings JobOpeningSettings?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model JobOpeningSettings {
  id String @id @default(uuid()) @db.Uuid

  jobOpeningId String     @unique @db.Uuid
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id])

  numberOfOpenings Int

  openingDate DateTime?

  expiryDate DateTime?

  evaluationScale Int @default(5)

  stages JobOpeningHiringStage[]

  jobOpeningDocuments JobOpeningDocumentRequirement[]

  hiringTeam JobOpeningHiringTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobOpeningDocumentRequirement {
  id                   String             @id @default(uuid()) @db.Uuid
  jobOpeningSettingsId String             @db.Uuid
  jobOpeningSettings   JobOpeningSettings @relation(fields: [jobOpeningSettingsId], references: [id])

  name       JobOpeningDocumentType
  isRequired Boolean                @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobOpeningHiringTeam {
  id String @id @default(uuid()) @db.Uuid

  jobOpeningSettingsId String             @db.Uuid
  jobOpeningSettings   JobOpeningSettings @relation(fields: [jobOpeningSettingsId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  role HiringTeamRole

  createdAt DateTime @default(now())

  @@index([jobOpeningSettingsId])
  @@index([userId])
}

model JobOpeningHiringStage {
  id String @id @default(uuid()) @db.Uuid

  settingsId String             @db.Uuid
  settings   JobOpeningSettings @relation(fields: [settingsId], references: [id])

  name String

  position Int

  isRequired Boolean @default(true)

  fromHistory    ApplicationStageHistory[] @relation("FromStage")
  toHistory      ApplicationStageHistory[] @relation("ToStage")
  jobApplication JobApplication[]
  createdAt      DateTime                  @default(now())

  @@unique([settingsId, position])
}

model Candidate {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  firstName String
  lastName  String

  email String
  phone String?

  linkedinUrl  String?
  portfolioUrl String?

  currentLocation String?

  yearsOfExperience Int?

  source CandidateSource @default(MANUAL_ENTRY)

  applications JobApplication[]
  notes        CandidateNote[]
  offers       JobOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
}

model JobApplicationDocument {
  id String @id @default(uuid()) @db.Uuid

  // candidateId String
  // candidate Candidate @relation(fields: [candidateId], references: [id])
  jobApplicationId String         @db.Uuid
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id])

  documentType CandidateDocumentType

  fileName String

  storageKey String

  mimeType String

  uploadedAt DateTime @default(now())

  createdAt DateTime @default(now())
}

model RecruitmentStage {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name String

  position Int

  isDefault Boolean @default(false)

  // applications JobApplication[]

  // fromHistory ApplicationStageHistory[] @relation("FromStage")
  // toHistory ApplicationStageHistory[] @relation("ToStage")

  createdAt DateTime @default(now())
}

model JobApplication {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  jobOpeningId String     @db.Uuid
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id])

  // currentStageId String?
  // currentStage RecruitmentStage? @relation(fields: [currentStageId], references: [id])

  currentStageId String?                @db.Uuid
  currentStage   JobOpeningHiringStage? @relation(fields: [currentStageId], references: [id])

  documents JobApplicationDocument[]
  // this is important

  // invitation OnboardingInvitation?
  status ApplicationStatus @default(ACTIVE)

  stageHistory ApplicationStageHistory[]

  notes CandidateNote[]

  activities RecruitmentActivity[]

  rejectionReason String?
  rejectedById    String? @db.Uuid
  rejectedBy      User?   @relation(fields: [rejectedById], references: [id])

  offers JobOffer[]

  appliedAt  DateTime  @default(now())
  rejectedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([candidateId, jobOpeningId])
}

model ApplicationStageHistory {
  id String @id @default(uuid()) @db.Uuid

  applicationId String         @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id])

  fromStageId String?                @db.Uuid
  fromStage   JobOpeningHiringStage? @relation("FromStage", fields: [fromStageId], references: [id])

  toStageId String                @db.Uuid
  toStage   JobOpeningHiringStage @relation("ToStage", fields: [toStageId], references: [id])

  movedById String @db.Uuid
  movedBy   User   @relation(fields: [movedById], references: [id])

  notes String?

  createdAt DateTime @default(now())
}

model JobOffer {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  applicationId String         @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id])

  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  jobOpeningId String     @db.Uuid
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id])

  salary Decimal @db.Decimal(18, 2)

  currency String @default("NGN")

  startDate DateTime?

  status OfferStatus @default(DRAFT)

  // offerLetter OfferLetterDocument?

  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruitmentActivity {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  applicationId String         @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id])

  actorId String @db.Uuid
  actor   User   @relation(fields: [actorId], references: [id])

  activityType String

  description String

  createdAt DateTime @default(now())
}

model CandidateNote {
  id String @id @default(uuid()) @db.Uuid

  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  applicationId String?         @db.Uuid
  application   JobApplication? @relation(fields: [applicationId], references: [id])

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  note String @db.Text

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

// LEAVE MODULE 

model LeaveType {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name String

  description String?

  daysPerYear Int

  isPaid Boolean @default(true)

  requiresApproval Boolean @default(true)

  approvalFrom ApprovalFrom?

  requiresDocument Boolean @default(false)

  documentType String?

  // Eligibility

  minimumMonthsOfService Int @default(0)

  // Notice

  noticePeriodDays Int @default(0)

  // Carry Forward

  allowCarryForward Boolean @default(false)

  maxCarryForwardDays Int?

  // Half Day

  allowHalfDay Boolean @default(false)

  // Probation

  availableDuringProbation Boolean @default(false)

  // Activation

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances      EmployeeLeaveBalance[]
  leaveRequests LeaveRequest[]
}

model EmployeeLeaveBalance {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  leaveTypeId String    @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  allocatedDays Int

  usedDays Int @default(0)

  remainingDays Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId])
}

model LeaveRequest {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation("currentLeaveRequests", fields: [employeeId], references: [id])

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  leaveTypeId String    @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  startDate DateTime

  endDate DateTime

  totalDays Int

  reason String?

  status LeaveRequestStatus @default(PENDING)

  approvedById String? @db.Uuid
  approvedBy   User?   @relation("acceptance", fields: [approvedById], references: [id])

  rejectedById String? @db.Uuid
  rejectedBy   User?   @relation("rejection", fields: [rejectedById], references: [id])

  relievedById String?   @unique @db.Uuid
  relievedBy   Employee? @relation("assignedReliever", fields: [relievedById], references: [id])

  approvedAt DateTime?

  rejectedAt DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history            LeaveApprovalHistory[]
  documentsInRequest LeaveRequestDocument[]
}

model LeaveApprovalHistory {
  id String @id @default(uuid()) @db.Uuid

  leaveRequestId String       @db.Uuid
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  actedById String? @db.Uuid
  actedBy   User?   @relation(fields: [actedById], references: [id])

  action LeaveActionType

  comment String?

  createdAt DateTime @default(now())
}

model PublicHoliday {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name String

  date DateTime

  createdAt DateTime @default(now())
}

model LeavePolicy {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  // Calendar rules
  excludeWeekends       Boolean @default(true)
  excludePublicHolidays Boolean @default(true)

  workingDays WeekDay[]

  // Eligibility
  minimumMonthsBeforeLeave Int @default(0)

  // Notice requirements
  minimumNoticeDays Int @default(0)

  // Carry forward
  allowCarryForward   Boolean @default(false)
  maxCarryForwardDays Int?

  // Negative balances
  allowNegativeBalance Boolean @default(false)

  // Leave encashment
  allowLeaveEncashment Boolean @default(false)

  // Cancellation
  allowEmployeeCancellation Boolean @default(true)
  cancellationNoticeDays    Int?

  // Half-day leave
  allowHalfDayLeave Boolean @default(false)

  // Probation rules
  allowLeaveDuringProbation Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveRequestDocument {
  id String @id @default(uuid()) @db.Uuid

  fileName String

  storageKey String

  mimeType String

  uploadedById String   @db.Uuid
  uploadedBy   Employee @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  leaveId String       @db.Uuid
  leave   LeaveRequest @relation(fields: [leaveId], references: [id])

  // jobOfferId String? @unique
  // jobOpening JobOffer? @relation(fields: [jobOfferId], references: [id])

  @@index([leaveId])
  @@map("leave_request_documents")
}

model PayrollComponent {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  description String?

  componentType PayrollComponentType

  calculationType ComponentCalculationType
  /// Only used when calculationType == FIXED
  fixedValue Decimal? @db.Decimal(18,2)

  /// Only used when calculationType == FORMULA
  ruleId String? @db.Uuid
  rule PayrollRule? @relation(fields: [ruleId], references: [id])

  isActive Boolean @default(true)

  employeeCompensations EmployeeCompensation[]

  payrollBreakdowns PayrollBreakdown[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])

  @@map("payroll_components")
}

model EmployeeCompensation {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  componentId String           @db.Uuid
  component   PayrollComponent @relation(fields: [componentId], references: [id])

  amount Decimal @db.Decimal(18, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([componentId])
  @@map("employee_compensations")
}

model PayrollRule {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  description String?

  expression Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components PayrollComponent[]

  @@unique([companyId, name])

  @@map("payroll_rules")
}

