generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  address             String?
  phone               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  employmentHistories EmploymentHistory[]
  departments         Department[]
  disciplinaryRecords DisciplinaryRecord[]
  employees           Employee[]
  users               User[]

  @@map("companies")
}

model Employee {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  employeeCode        String
  firstName           String
  lastName            String
  gender              Gender
  dateOfBirth         DateTime?
  address             String?
  jobTitle            String?
  employmentType      EmploymentType?
  managerId           String?              @db.Uuid
  employmentStatus    EmploymentStatus     @default(ACTIVE)
  departmentId        String?              @db.Uuid
  userId              String               @unique @db.Uuid
  hireDate            DateTime?
  updatedAt           DateTime             @updatedAt
  createdAt           DateTime             @default(now())
  deletedAt           DateTime?
  employmentHistory   EmploymentHistory[]
  headedDepartments   Department[]         @relation("DepartmentHead")
  disciplinaryRecords DisciplinaryRecord[]
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department          Department?          @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  manager             Employee?            @relation("ManagerEmployees", fields: [managerId], references: [id])
  subordinates        Employee[]           @relation("ManagerEmployees")
  user                User                 @relation(fields: [userId], references: [id])

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([departmentId])
  @@map("employees")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String
  email                String               @unique
  password             String
  phone                String?
  role                 Role
  isActive             Boolean              @default(true)
  lastLogin            DateTime?
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  companyId            String               @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  disciplinaryCreated  DisciplinaryRecord[] @relation("DisciplinaryCreatedBy")
  disciplinaryResolved DisciplinaryRecord[] @relation("DisciplinaryResolvedBy")
  employee             Employee?
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("users")
}

model Department {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  name               String
  description        String?
  status             DepartmentStatus    @default(ACTIVE)
  parentDepartmentId String?             @db.Uuid
  headEmployeeId     String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  employmentHistory  EmploymentHistory[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  headEmployee       Employee?           @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  parentDepartment   Department?         @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[]        @relation("DepartmentHierarchy")
  employees          Employee[]          @relation("DepartmentEmployees")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([headEmployeeId])
  @@index([parentDepartmentId])
  @@map("departments")
}

model EmploymentHistory {
  employeeId   String      @db.Uuid
  departmentId String?     @db.Uuid
  jobTitle     String
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  companyId    String      @db.Uuid
  id           String      @id @default(uuid()) @db.Uuid
  company      Company     @relation(fields: [companyId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  employee     Employee    @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([employeeId, isCurrent])
  @@index([isCurrent])
}

model DisciplinaryRecord {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @db.Uuid
  employeeId      String               @db.Uuid
  type            DisciplinaryType
  severity        DisciplinarySeverity
  title           String
  description     String
  status          DisciplinaryStatus   @default(OPEN)
  createdById     String               @db.Uuid
  resolvedById    String?              @db.Uuid
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("DisciplinaryCreatedBy", fields: [createdById], references: [id])
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resolvedBy      User?                @relation("DisciplinaryResolvedBy", fields: [resolvedById], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("disciplinary_records")
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentStatus {
  ACTIVE
  TERMINATED
  RESIGNED
  SUSPENDED
}

enum Role {
  HR_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum DisciplinaryStatus {
  OPEN
  RESOLVED
}

enum DisciplinarySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DisciplinaryType {
  WARNING
  MISCONDUCT
  LATENESS
  PERFORMANCE
  SUSPENSION
  OTHER
}
