// Payroll

model PayrollRun {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  month Int
  year  Int

  status PayrollStatus @default(DRAFT)

  generatedById String @db.Uuid
  generatedBy   User   @relation(fields: [generatedById], references: [id])

  generatedAt DateTime @default(now())

  lockedAt DateTime?

  paidAt DateTime?

  notes String?

  payrollItems PayrollItem[]
  salaryAdvanc SalaryAdvance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, month, year])
  @@map("payroll_runs")
}

model PayrollItem {
  id String @id @default(uuid()) @db.Uuid

  payrollRunId String     @db.Uuid
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])

  grossPay Decimal @db.Decimal(18, 2)

  totalEarnings Decimal @db.Decimal(18, 2)

  totalDeductions Decimal @db.Decimal(18, 2)

  netPay Decimal @db.Decimal(18, 2)

  breakdown PayrollBreakdown[]

  createdAt DateTime @default(now())

  @@unique([payrollRunId, employeeId])
  @@map("payroll_items")
}

model PayrollBreakdown {
  id String @id @default(uuid()) @db.Uuid

  payrollItemId String      @db.Uuid
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  componentId String           @db.Uuid
  component   PayrollComponent @relation(fields: [componentId], references: [id])

  componentName String
  amount Decimal @db.Decimal(18, 2)

  type PayrollComponentType

  createdAt DateTime @default(now())

  @@map("payroll_breakdowns")
}

model SalaryAdvance {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedAmount Decimal @db.Decimal(18, 2)

  approvedAmount Decimal? @db.Decimal(18, 2)
  reason         String?

  requestedById String @db.Uuid
  requestedBy   User   @relation("salary_advance_reqs", fields: [requestedById], references: [id])

  payrollRunId String? @db.Uuid

  payrollRun    PayrollRun? @relation(fields: [payrollRunId], references: [id])
  requestedDate DateTime    @default(now())

  approvedById String? @db.Uuid
  approvedBy   User?   @relation("salary_advance_approvals", fields: [approvedById], references: [id])

  status AdvanceStatus @default(PENDING)

  approvedDate  DateTime?
  rejectedDate  DateTime?
  reviewComment String?
  createdAt     DateTime  @default(now())

  updatedAt      DateTime         @updatedAt
  advanceReceipt AdvanceReceipt[]

  @@map("salary_advance")
}

model AdvanceReceipt {
  id String @id @default(uuid()) @db.Uuid

  fileName String

  storageKey String

  mimeType String

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  salaryAdvanceId String        @db.Uuid
  salaryAdvance   SalaryAdvance @relation(fields: [salaryAdvanceId], references: [id])

  @@index([salaryAdvanceId])
  @@map("salary_advance_documents")
}

